# Copy to .env and fill in. .env is gitignored (CLAUDE.md R8).

# ENTSO-E Transparency Platform REST API.
# Register at https://transparency.entsoe.eu, then email transparency@entsoe.eu
# with subject "RESTful API access" and your account email address.
# Token is typically issued within a few working days.
ENTSOE_API_TOKEN=

# TenneT API (developer.tennet.eu). Register (name + email + accept the privacy
# statement and fair use policy), then obtain a subscription key.
# The API is fronted by Azure API Management, so the header is usually
# `Ocp-Apim-Subscription-Key` -- confirm the exact name via the "Authorize"
# button on the spec page and override below only if it differs.
TENNET_API_KEY=
# TENNET_API_KEY_HEADER=Ocp-Apim-Subscription-Key

# Optional. KNMI Data Platform, free with registration.
KNMI_API_KEY=

# Open-Meteo needs no key for non-commercial use.
